# ===== เรียก RMUTI API ด้วย Basic auth =====
# endpoint ของ RMUTI API ที่ต้องการเรียก
RMUTI_API_URL=https://api.example.com/api/v4/network/profile/
# username / password ที่ได้จาก RMUTI Developer Portal (ใช้ต่อ API / ต่อ endpoint ตามที่ขอไว้)
RMUTI_API_USERNAME=your-api-username
RMUTI_API_PASSWORD=your-api-password
