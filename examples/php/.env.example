# ===== RMUTI Passport (Keycloak) =====
# URL ของ realm เช่น https://<sso-host>/realms/<realm>  (ขอค่าจริงจากผู้ดูแลระบบ RMUTI Passport)
KEYCLOAK_ISSUER=https://sso.example.com/realms/your-realm
KEYCLOAK_CLIENT_ID=your-client-id
KEYCLOAK_CLIENT_SECRET=your-client-secret

# scope ที่ใช้ตอน login (คั่นด้วยช่องว่าง ต้องมี openid เสมอ)
# ข้อมูลผู้ใช้ที่ได้ และ API ที่เรียกได้ ขึ้นกับ scope ที่ระบบได้รับอนุมัติ — คัดลอกค่าจริงจากหน้า My Apps ใน api-portal
KEYCLOAK_SCOPE=openid example_user_scope example:api_scope

# ต้องลงทะเบียนใน Keycloak client: "Valid redirect URIs" และ "Valid post logout redirect URIs"
REDIRECT_URI=http://localhost:8000/callback.php
POST_LOGOUT_REDIRECT_URI=http://localhost:8000/

# ===== RMUTI API (ไม่บังคับ) =====
# endpoint ของ RMUTI API ที่ต้องการเรียกด้วย access token ของผู้ใช้
# ต้องใส่ scope ของ endpoint นี้ใน KEYCLOAK_SCOPE ด้วย ไม่อย่างนั้นจะได้ 403 (ดู scope ได้ที่หน้า My Apps ใน api-portal)
PROFILE_API_URL=https://api.example.com/v1/profile
